# Windows PowerShell 5.1 は BOM の無い .ps1 を CP932 として読むため、
# 日本語が文字化けして構文エラーになる。BOM と CRLF を必ず保持する。
*.ps1 text eol=crlf working-tree-encoding=UTF-8

# シェルスクリプトは LF のまま (CRLF だと bash が実行できない)
*.sh text eol=lf

# .bat は日本語 Windows の cmd が CP932 で読む。
# 文字コードは git では変換されないが、改行は CRLF に固定する。
*.bat text eol=crlf

# Finder からダブルクリックする起動用スクリプト
*.command text eol=lf
