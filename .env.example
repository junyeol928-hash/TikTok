# ttradar の秘密情報。このファイルを .env にコピーして書き換えてください。
# .env は .gitignore 済みなのでコミットされません。

# --- 通知 (使うものだけ設定すればよい) ---
# Slack: ワークスペース設定 > Incoming Webhooks で取得
TTRADAR_SLACK_WEBHOOK=

# Discord: チャンネル設定 > 連携サービス > ウェブフック で取得
TTRADAR_DISCORD_WEBHOOK=

# メール (Gmail の場合はアプリパスワードを使う)
TTRADAR_SMTP_HOST=smtp.gmail.com
TTRADAR_SMTP_PORT=587
TTRADAR_SMTP_USER=
TTRADAR_SMTP_PASSWORD=
TTRADAR_EMAIL_TO=

# --- 有料分析サービス (任意。契約している場合のみ) ---
KALODATA_API_KEY=
FASTMOSS_API_KEY=
ECHOTIK_API_KEY=

# --- TikTok ログインが必要な画面を取る場合 (任意) ---
# ブラウザの開発者ツール > Application > Cookies から sessionid をコピー
# 注意: これは自分のアカウントの認証情報です。絶対に共有しないでください。
TIKTOK_SESSION_COOKIE=

# --- 動作 ---
# TTRADAR_DB=data/ttradar.db
# TTRADAR_DEBUG=1
